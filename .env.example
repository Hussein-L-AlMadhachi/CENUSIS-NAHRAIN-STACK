# CENUSIS-Ops Environment Variables
# Copy this file to .env and update with your values

# JWT Secret - CHANGE THIS IN PRODUCTION!
# Generate a secure random string: openssl rand -base64 32
JWT_SECRET=your-very-secure-secret-key-change-in-production

# Database Configuration (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=cenusis_ops
DB_USER=dev
DB_PASSWORD=dev123456

# App Environment (production enables secure cookies)
NODE_ENV=production

# Network Configuration
# Set this to your server's IP address or domain name
# Examples: 192.168.1.100, example.com, app.example.com
NGINX_HOST=localhost
